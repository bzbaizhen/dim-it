{
  "name": "dim-it",
  "version": "0.4.0",
  "private": true,
  "description": "Dim It - PDF 图纸工作台 | Offline PDF drawing measurement",
  "author": "Dim It",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "node scripts/copy-pdf-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/quickstart-e2e.mjs && node tests/e2e.mjs && node tests/snap-e2e.mjs && node tests/smarttrack-e2e.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "pretest": "node scripts/create-test-fixtures.mjs",
    "pretest:e2e": "node scripts/create-test-fixtures.mjs"
  },
  "build": {
    "appId": "local.planmeasure.desktop",
    "productName": "Dim It",
    "directories": {
      "output": "release/0.4.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "DimIt-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
